flowchart TB
    Incoming[Incoming intent] --> Parse[Parse URL, URI, extras, referrer]
    Parse --> Scheme{Supported browser scheme?}
    Scheme -->|HTTP/HTTPS| Validate[Validate URL and profile context]
    Scheme -->|Unsupported or dangerous| Reject[Reject safely]
    Validate --> Trusted{Safe to navigate?}
    Trusted -->|Yes| Navigate[Open in selected profile]
    Trusted -->|No| Reject
    Navigate --> Chromium[Chromium navigation]
    Reject --> Explain[Show safe error or no-op]

    classDef input fill:#dbeafe,stroke:#2563eb,color:#172554,stroke-width:1.5px
    classDef check fill:#fef3c7,stroke:#b45309,color:#78350f,stroke-width:1.5px
    classDef safe fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:1.5px
    classDef danger fill:#fee2e2,stroke:#dc2626,color:#7f1d1d,stroke-width:1.5px
    class Incoming,Parse input
    class Scheme,Validate,Trusted check
    class Navigate,Chromium safe
    class Reject,Explain danger
